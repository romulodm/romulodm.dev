{
  "name": "romulodm",
  "private": true,
  "workspaces": [
    "packages/*",
    "portfolio",
    "worker"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck:portfolio && npm run typecheck:worker",
    "typecheck:portfolio": "npm --prefix portfolio run typecheck",
    "typecheck:worker": "npm --prefix worker run typecheck",
    "build:portfolio": "npm --prefix portfolio run build",
    "build:database": "npm --prefix packages/database run generate && npm --prefix packages/database run build",
    "build:queues": "npm --prefix packages/queues run build",
    "build:web3": "npm --prefix packages/web3 run build",
    "build:templates": "npm --prefix packages/templates run build",
    "build:worker": "npm --prefix worker run build",
    "ci:packages": "npm run build:database && npm run build:queues && npm run build:templates && npm run build:web3",
    "ci:portfolio": "npm run lint && npm run typecheck && npm run build:portfolio",
    "ci:worker": "npm run build:worker",
    "ci:phase1": "npm run ci:packages && npm run ci:worker && npm run lint && npm run typecheck",
    "ci": "npm run ci:phase1 && npm run build:portfolio",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "npm --prefix portfolio run test:e2e",
    "test:phase3": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit:portfolio": "npm --prefix portfolio run test:unit",
    "test:unit:worker": "npm --prefix worker run test:unit",
    "test:unit:database": "npm --prefix packages/database run test:unit",
    "test:unit:queues": "npm --prefix packages/queues run test:unit",
    "test:integration:portfolio": "npm --prefix portfolio run test:integration",
    "test:integration:worker": "npm --prefix worker run test:integration",
    "test:integration:database": "npm --prefix packages/database run test:integration",
    "test:integration:queues": "npm --prefix packages/queues run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "picomatch": "^4.0.2",
    "yaml": "^2.8.3",
    "nodemailer": "^8.0.5",
    "basic-ftp": "^5.2.2"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1032.0"
  }
}