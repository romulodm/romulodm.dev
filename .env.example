# Root/shared environment contract
# Most runtime variables live in per-surface example files.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
REDIS_URL="redis://HOST:6379"
NODE_ENV="development"

# Worker throughput tuning
WORKER_TRANSACTIONAL_CONCURRENCY="8"
WORKER_CAMPAIGN_CONCURRENCY="12"
WORKER_CAMPAIGN_RATE_LIMIT_MAX="20"
WORKER_CAMPAIGN_RATE_LIMIT_DURATION_MS="1000"
WORKER_NOTIFICATION_CONCURRENCY="1"
WORKER_VIEWS_FLUSH_BATCH_SIZE="100"
WORKER_VIEWS_FLUSH_INTERVAL_MS="120000"
