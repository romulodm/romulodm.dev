# Queue + persistence
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
REDIS_URL="redis://HOST:6379"

# Public app metadata for links/messages
NEXT_PUBLIC_APP_NAME="Your Portfolio"
NEXT_PUBLIC_APP_URL="https://example.com"

# WhatsApp / WAHA
WAHA_URL="https://waha.example.com"
WAHA_CHAT_ID="000000000000@c.us"
WAHA_API_KEY="your-waha-api-key"

# Umami status reporting
UMAMI_URL="https://umami.example.com"
UMAMI_USER="your-umami-user"
UMAMI_PASSWORD="your-umami-password"
UMAMI_SITE_ID="your-umami-site-id"
UMAMI_SHARED_URL="https://umami.example.com/share/your-site"

# Email provider
EMAIL_PROVIDER="smtp"
EMAIL_FROM_NAME="Your Portfolio"

# SMTP mode
SMTP_FROM="noreply@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"

# SES mode
SES_FROM="noreply@example.com"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
