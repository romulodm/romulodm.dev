// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL_PASSWORD
  GOOGLE
}

model User {
  id            String   @id @default(cuid())
  admin         Boolean  @default(false)
  username      String   @unique
  password      String?  @db.VarChar(255)
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String? //URL
  about         String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  githubUrl     String?
  linkedinUrl   String?

  banned   Boolean   @default(false)
  bannedAt DateTime?

  suspiciousComments SuspiciousComment[]

  provider            AuthProvider
  sub                 String? // provider-specific user ID
  passwordResetTokens PasswordResetToken[]

  comments  Comment[]
  votes     CommentVote[]
  postLikes PostLike[]
  posts     Post[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id            String     @id @default(cuid())
  slug          String     @unique
  readingTime   Int        @default(0)
  coverImageUrl String?
  youtubeUrl    String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  views         Int        @default(0)
  likes         Int        @default(0)
  commentsCount Int        @default(0)
  authorId      String

  author             User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postTags           PostTag[]
  comments           Comment[]
  postLikes          PostLike[]
  campaigns          Campaign[]
  translations       PostTranslation[]
  suspiciousComments SuspiciousComment[]

  @@index([status, publishedAt])
  @@index([status, likes, publishedAt])
  @@index([status, views, publishedAt])
  @@index([authorId])
}

model PostTranslation {
  id              String  @id @default(cuid())
  postId          String
  locale          String
  title           String
  summary         String? @db.VarChar(500)
  excerpt         String? @db.Text
  contentMarkdown String  @db.Text
  canonicalUrl    String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([postId])
  @@index([locale])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([postId])
  @@index([tag])
}

model SuspiciousComment {
  id        String   @id @default(cuid())
  postId    String
  parentId  String?
  authorId  String
  bodyMd    String   @db.VarChar(2000)
  reason    String?
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  parentId  String?
  authorId  String
  bodyMd    String    @db.VarChar(2000)
  score     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // tree
  parent  Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentTree")

  votes CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([postId, parentId, score])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  value     Int // +1 or -1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model NewsletterSubscriber {
  id                  String    @id @default(cuid())
  email               String    @unique
  isConfirmed         Boolean   @default(false)
  confirmationToken   String?   @unique
  confirmationExpires DateTime?
  subscribedAt        DateTime?
  unsubscribedAt      DateTime?
  unsubscribeToken    String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([confirmationToken])
  @@index([unsubscribeToken])
  @@index([isConfirmed, unsubscribedAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

// POST_BASED  → linked to a Post; subject/content generated from the post
// CUSTOM      → free-form HTML content written by the admin
enum CampaignType {
  POST_BASED
  CUSTOM
}

model Campaign {
  id          String         @id @default(cuid())
  type        CampaignType   @default(CUSTOM)
  subject     String
  previewText String?
  content     String         @db.Text
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  postId      String?

  // Aggregate metrics (denormalised for fast reads)
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)
  openCount       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post       Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([postId])
  @@index([type])
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  subscriberId String
  // Unique ID embedded in the tracking pixel URL
  trackingId   String    @unique @default(cuid())
  // PENDING | SENT | FAILED
  status       String    @default("PENDING")
  sentAt       DateTime?
  openedAt     DateTime?
  openCount    Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign   Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([subscriberId])
  @@index([trackingId])
}

enum DonationProvider {
  STRIPE
  PIX
  ETH
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model Donation {
  id        String           @id @default(cuid())
  name      String?          @db.VarChar(100)
  message   String?          @db.VarChar(500)
  coffees   Int              @default(1)
  amount    Int
  currency  String           @default("BRL")
  provider  DonationProvider
  status    DonationStatus   @default(PENDING)
  isPrivate Boolean          @default(false)
  isMonthly Boolean          @default(false)

  stripePaymentIntentId String? @unique
  abacatePayChargeId    String? @unique
  txHash                String? @unique
  walletAddress         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, isPrivate, createdAt])
  @@index([status, isPrivate, currency, amount])
  @@index([amount])
  @@index([provider])
}
