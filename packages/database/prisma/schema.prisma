generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  email                 String                 @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  /// Foto vinda do provider OAuth. Nunca sobrescrita nem apagada: se o usuario
  /// troca para o avatar gerado, ela continua aqui para ele poder voltar.
  image                 String?
  /// Semente do seedicon. UUID em vez do username porque o usuario troca de
  /// avatar gerando um UUID novo — se fosse o username, mudar de avatar
  /// obrigaria a mudar de nome, e mudar de nome trocaria o avatar sem querer.
  ///
  /// O default e de nivel Prisma (gerado no client, como o cuid() do `id`
  /// acima), nao no banco: a migration que criou a coluna preencheu as linhas
  /// existentes com gen_random_uuid() e deixou NOT NULL sem DEFAULT. Existe
  /// para que nenhum `user.create` — fixture de teste, seed, rota nova —
  /// consiga esquecer a semente.
  avatarSeed            String                 @default(uuid())
  /// Nome do estilo do seedicon. String, e nao enum do Prisma: uma release nova
  /// do pacote com mais estilos nao deve exigir migration. A validacao vive na
  /// borda, contra SEEDICON_STYLES (portfolio/lib/avatar.ts).
  avatarStyle           String                 @default("pixels")
  /// Qual das duas imagens renderizar. As duas coexistem sempre.
  avatarSource          AvatarSource           @default(SEEDICON)
  admin                 Boolean                @default(false)
  emailVerified         Boolean                @default(false)
  password              String?                @db.VarChar(255)
  provider              AuthProvider
  sub                   String?
  about                 String?                @db.VarChar(1000)
  githubUrl             String?
  linkedinUrl           String?
  banned                Boolean                @default(false)
  bannedAt              DateTime?
  banReason             String?                @db.VarChar(500)
  comments              Comment[]
  votes                 CommentVote[]
  donations             Donation[]
  newsletterSubscribers NewsletterSubscriber[]
  passwordResetTokens   PasswordResetToken[]
  posts                 Post[]
  postLikes             PostLike[]
  suspiciousComments    SuspiciousComment[]
  wallMessages          WallMessage[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id                 String              @id @default(cuid())
  slug               String              @unique
  coverImageUrl      String?
  status             PostStatus          @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  likes              Int                 @default(0)
  views              Int                 @default(0)
  commentsCount      Int                 @default(0)
  youtubeUrl         String?
  authorId           String
  readingTime        Int                 @default(0)
  campaigns          Campaign[]
  comments           Comment[]
  author             User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postLikes          PostLike[]
  postTags           PostTag[]
  translations       PostTranslation[]
  suspiciousComments SuspiciousComment[]
  campaignPosts      CampaignPost[]

  @@index([status, publishedAt])
  @@index([status, likes, publishedAt])
  @@index([status, views, publishedAt])
  @@index([authorId])
}

model PostTranslation {
  id              String  @id @default(cuid())
  postId          String
  locale          String
  title           String
  summary         String? @db.VarChar(500)
  excerpt         String?
  contentMarkdown String
  canonicalUrl    String?
  post            Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([postId])
  @@index([locale])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([postId])
  @@index([tag])
}

model SuspiciousComment {
  id        String   @id @default(cuid())
  postId    String
  parentId  String?
  authorId  String
  bodyMd    String   @db.VarChar(2000)
  reason    String?
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  parentId  String?
  authorId  String
  bodyMd    String        @db.VarChar(2000)
  score     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  editedAt  DateTime?
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentTree")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([postId, parentId, score])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model NewsletterSubscriber {
  id                  String              @id @default(cuid())
  email               String              @unique
  isConfirmed         Boolean             @default(false)
  confirmationToken   String?             @unique
  confirmationExpires DateTime?
  subscribedAt        DateTime?
  unsubscribedAt      DateTime?
  unsubscribeToken    String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  preferredLocale     String              @default("en")
  userId              String?
  recipients          CampaignRecipient[]
  user                User?               @relation(fields: [userId], references: [id])

  @@index([confirmationToken])
  @@index([unsubscribeToken])
  @@index([isConfirmed, unsubscribedAt])
  @@index([userId])
}

model Campaign {
  id              String              @id @default(cuid())
  subject         String
  previewText     String?
  content         String
  status          CampaignStatus      @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  postId          String?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  openCount       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  type            CampaignType        @default(CUSTOM)
  post            Post?               @relation(fields: [postId], references: [id])
  recipients      CampaignRecipient[]
  campaignPosts   CampaignPost[]

  @@index([status, scheduledAt])
  @@index([postId])
  @@index([type])
}

model CampaignRecipient {
  id           String               @id @default(cuid())
  campaignId   String
  subscriberId String
  trackingId   String               @unique @default(cuid())
  status       String               @default("PENDING")
  sentAt       DateTime?
  openedAt     DateTime?
  openCount    Int                  @default(0)
  errorMessage String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([subscriberId])
  @@index([trackingId])
}

model CampaignPost {
  id         String @id @default(cuid())
  campaignId String
  postId     String
  order      Int    @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([campaignId, postId])
  @@index([campaignId, order])
}

model Donation {
  id                    String           @id @default(cuid())
  name                  String?          @db.VarChar(100)
  message               String?          @db.VarChar(500)
  coffees               Int              @default(1)
  amount                Int
  currency              String           @default("BRL")
  provider              DonationProvider
  status                DonationStatus   @default(PENDING)
  isPrivate             Boolean          @default(false)
  isMonthly             Boolean          @default(false)
  stripePaymentIntentId String?          @unique
  abacatePayChargeId    String?          @unique
  txHash                String?          @unique
  walletAddress         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
  @@index([status, isPrivate, createdAt])
  @@index([status, isPrivate, currency, amount])
  @@index([amount])
  @@index([provider])
}

model OnChainDonation {
  id               String   @id @default(cuid())
  txHash           String   @unique
  network          String
  token            String
  rawAmount        String
  amountUsd        Float
  amountBrl        Float
  coffees          Int
  donor            String
  name             String?  @db.VarChar(100)
  message          String?  @db.VarChar(1400)
  encryptedMessage String?
  isPrivate        Boolean  @default(false)
  blockNumber      String
  donatedAt        DateTime
  createdAt        DateTime @default(now())

  @@index([network, donatedAt])
  @@index([donor])
  @@index([amountBrl])
  @@index([token])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  /// RECEIVED | PROCESSED | IGNORED | FAILED
  status      String    @default("RECEIVED")
  error       String?   @db.VarChar(1000)
  donationId  String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([donationId])
  @@index([receivedAt])
}

model WallMessage {
  id        String   @id @default(cuid())
  message   String   @db.VarChar(100)
  authorId  String
  theme     Int      @default(0)
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
}

enum AuthProvider {
  EMAIL_PASSWORD
  GOOGLE
  GITHUB
}

enum AvatarSource {
  /// Renderiza User.image (foto do Google/GitHub).
  PROVIDER
  /// Renderiza o seedicon a partir de avatarSeed + avatarStyle.
  SEEDICON
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CampaignType {
  POST_BASED
  CUSTOM
  DIGEST
}

enum DonationProvider {
  STRIPE
  PIX
  ETH
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(80)
  email     String        @db.VarChar(160)
  topic     ContactTopic
  message   String        @db.VarChar(2000)
  status    ContactStatus @default(RECEIVED)
  locale    String        @db.VarChar(5)
  /// sha256(APP_SECRET + IP). Guardamos o hash e nao o IP: o rate limit vive
  /// no Redis com chave efemera, e o que sobra de util aqui e so responder
  /// "essas mensagens vieram todas do mesmo lugar?".
  ipHash    String        @db.VarChar(64)
  userAgent String?       @db.VarChar(300)
  createdAt DateTime      @default(now())
  readAt    DateTime?
  repliedAt DateTime?
  closedAt  DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

enum ContactTopic {
  FULL_TIME
  FREELANCE
  SAYING_HI
  BUG_REPORT
  OTHER
}

enum ContactStatus {
  RECEIVED
  READ
  REPLIED
  CLOSED
  SPAM
}
