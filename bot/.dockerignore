# O Dockerfile faz `COPY . .`. Sem esta lista, o .env com o TELEGRAM_BOT_TOKEN e
# o NOTIFY_SECRET vai para dentro da imagem — e continua la, num layer, mesmo
# que o Render injete os mesmos valores por variavel de ambiente em runtime.
.env
.env.*
.git
.gitignore
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
