# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_blog?schema=public"

# Admin Auth (escolha uma das opções)
# Opção 1: Senha simples (recomendado para MVP)
ADMIN_PASSWORD="seu_password_seguro_aqui"

# Opção 2: NextAuth com Google (opcional)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="gere_um_secret_com_openssl_rand_base64_32"
# GOOGLE_CLIENT_ID="seu_google_client_id"
# GOOGLE_CLIENT_SECRET="seu_google_client_secret"
# ADMIN_EMAIL="seu_email@gmail.com"

# MinIO / S3 Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="portfolio-blog"
MINIO_USE_SSL="false"
MINIO_PUBLIC_URL="http://localhost:9000"

# Session
SESSION_SECRET="gere_outro_secret_seguro_aqui_com_openssl_rand_base64_32"

# Site Config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Seu Nome - Portfolio & Blog"
NEXT_PUBLIC_SITE_DESCRIPTION="Portfolio e Blog de desenvolvimento"

# Email (para newsletter - opcional, pode usar console.log no MVP)
# EMAIL_FROM="noreply@seusite.com"
# RESEND_API_KEY="re_..."
