# Shared infra
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
REDIS_URL="redis://HOST:6379"

# Core app URLs
NEXT_PUBLIC_APP_URL="https://example.com"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_NAME="Your Portfolio"
NEXT_PUBLIC_SITE_DESCRIPTION="Public portfolio and services"
NEXT_PUBLIC_APP_NAME="Your Portfolio"

# Auth / admin
ADMIN_PASSWORD="set-a-strong-admin-password"
NEXTAUTH_URL="https://example.com"
NEXTAUTH_SECRET="generate-a-random-secret"
SESSION_SECRET="generate-a-second-random-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
ADMIN_EMAIL="admin@example.com"
CRON_SECRET="generate-a-random-cron-secret"

# Storage / uploads
MINIO_ENDPOINT="storage.example.com"
MINIO_PORT="443"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_NAME="portfolio-assets"
MINIO_USE_SSL="true"
MINIO_PUBLIC_URL="https://cdn.example.com"

# Email / newsletter
NEXT_PUBLIC_URL_EMAIL="https://form-endpoint.example.com"
NEXT_PUBLIC_ACCESSKEY_EMAIL="your-form-access-key"
EMAIL_FROM="noreply@example.com"

# Payments / donations
STRIPE_SECRET_KEY="sk_live_or_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_placeholder"
ABACATE_PAY_API_KEY="your-abacate-pay-api-key"
ABACATE_PAY_WEBHOOK_SECRET="your-abacate-webhook-secret"
NEXT_PUBLIC_ETH_WALLET_ADDRESS="0xYourWalletAddress"
ETH_WALLET_ADDRESS="0xYourWalletAddress"
ETHERSCAN_API_KEY="your-etherscan-api-key"

# Moderation / external APIs
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_SAFE_BROWSING_API_KEY="your-google-safe-browsing-key"

# Analytics / embeds
NEXT_PUBLIC_UMAMI_URL="https://umami.example.com"
NEXT_PUBLIC_UMAMI_ID="your-umami-website-id"
NEXT_GITHUB_TOKEN="optional-github-token"

# Optional UI / terminal secrets
NEXT_PUBLIC_TERMINAL_SECRET_PASSWORD="optional-terminal-password"
NEXT_PUBLIC_TERMINAL_SECRET_REWARD="https://example.com/reward"
